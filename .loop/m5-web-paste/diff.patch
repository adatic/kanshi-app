+/* 七言絶句の作業台：静かな紙面。墨・藍のアクセント。違反は朱、要確認は黄土、変格は緑青。色だけに頼らず記号を添える。
+   外部フォントは使わない（初回の静的ファイルの取得以外は通信しない。CLAUDE.md §6.3） */
+:root {
+  --paper: #f1f3f1;
+  --sheet: #fbfcfb;
+  --ink: #1d2326;
+  --muted: #5b666b;
+  --line: #d4dbd7;
+  --ai: #2b4a78;
+  --ai-soft: #e2e8f1;
+  --shu: #b0392b;
+  --shu-soft: #f6e2de;
+  --odo: #885900;
+  --odo-soft: #f5ead2;
+  --rokusho: #2c6d61;
+  --rokusho-soft: #dceee9;
+  --f-han: "Hiragino Mincho ProN", "Yu Mincho", "YuMincho", "Noto Serif CJK JP", "Noto Serif JP", "Songti TC", serif;
+  --f-ui: system-ui, -apple-system, "Hiragino Sans", "Yu Gothic UI", "Noto Sans CJK JP", sans-serif;
+  color-scheme: light;
+}
+@media (prefers-color-scheme: dark) {
+  :root {
+    --paper: #151a1c;
+    --sheet: #1c2225;
+    --ink: #e5e9e7;
+    --muted: #9ba6aa;
+    --line: #2f383b;
+    --ai: #91b1e4;
+    --ai-soft: #233149;
+    --shu: #ec8f82;
+    --shu-soft: #3d231f;
+    --odo: #e0b05a;
+    --odo-soft: #3a2e17;
+    --rokusho: #7fc9b8;
+    --rokusho-soft: #1d3632;
+    color-scheme: dark;
+  }
+}
+
+* {
+  box-sizing: border-box;
+}
+html {
+  -webkit-text-size-adjust: 100%;
+}
+body {
+  margin: 0;
+  background: var(--paper);
+  color: var(--ink);
+  font-family: var(--f-ui);
+  font-size: 15px;
+  line-height: 1.7;
+  padding-left: max(16px, env(safe-area-inset-left, 0px));
+  padding-right: max(16px, env(safe-area-inset-right, 0px));
+}
+header.site,
+main,
+footer.site {
+  max-width: 1080px;
+  margin: 0 auto;
+}
+header.site {
+  padding-block: 28px 8px;
+}
+h1 {
+  font-family: var(--f-han);
+  font-size: 1.8rem;
+  letter-spacing: 0.1em;
+  margin: 0;
+  text-wrap: balance;
+}
+.lede {
+  color: var(--muted);
+  margin: 4px 0 0;
+  max-width: 62ch;
+}
+footer.site {
+  color: var(--muted);
+  font-size: 0.8rem;
+  padding-block: 24px 40px;
+}
+.loading,
+.error {
+  color: var(--muted);
+}
+.error {
+  color: var(--shu);
+}
+
+/* 貼り付けモード：左に入力と設定、右に結果。狭い画面では縦に積む */
+.mode {
+  display: grid;
+  grid-template-columns: minmax(260px, 340px) minmax(0, 1fr);
