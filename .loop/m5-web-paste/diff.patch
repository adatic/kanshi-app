+.ch.sev-variant .mark {
+  color: var(--rokusho);
+}
+.legend {
+  font-size: 0.8rem;
+  color: var(--muted);
+  margin: -8px 0 0;
+}
+.result section {
+  background: var(--sheet);
+  border: 1px solid var(--line);
+  border-radius: 10px;
+  padding: 12px 16px;
+  min-width: 0;
+}
+h3 {
+  font-size: 1rem;
+  margin: 0 0 8px;
+  display: flex;
+  gap: 8px;
+  align-items: baseline;
+}
+h4 {
+  font-size: 0.9rem;
+  margin: 12px 0 4px;
+}
+.count {
+  color: var(--muted);
+  font-size: 0.8rem;
