+// データ検査（CLAUDE.md §4.3）。`npm test` で走る。
+// 生成物（data/*.json）が、エンジンが前提にしてよい形になっているかを確かめる。
+// 平仄・韻目の正誤そのものは判定しない（根拠は元データとゴールデンテストに置く）。
+import { readFileSync } from "node:fs";
+import { describe, expect, it } from "vitest";
+
+type Tone = "平" | "上" | "去" | "入";
+type Reading = { tone: Tone; rhyme: string; note?: string };
+type Rhyme = { id: string; tone: Tone };
+
+const read = (path: string) => readFileSync(new URL(`../data/${path}`, import.meta.url), "utf-8");
+
+const rhymes: Rhyme[] = JSON.parse(read("rhymes.json"));
+const charsText = read("chars.json");
+const chars: Record<string, Reading[]> = JSON.parse(charsText);
+const variants: Record<string, string[]> = JSON.parse(read("variants.json"));
+const kokuji: {
+  source: { url: string; license: string };
+  chars: { char: string; note?: string }[];
+} = JSON.parse(read("kokuji.json"));
+const corrections: {
+  corrections: { action: string; char: string; rhyme: string; reason: string; evidence: string[] }[];
+} = JSON.parse(read("corrections.json"));
+
+const TONES: readonly Tone[] = ["平", "上", "去", "入"];
+const PREFIX_TONE: Record<string, Tone> = { 上平: "平", 下平: "平", 上声: "上", 去声: "去", 入声: "入" };
+const RHYME_ID = /^(上平|下平|上声|去声|入声)([一二三四五六七八九十]+)(\p{Script=Han})$/u;
+const NOTES = new Set(["【詞】", "【辭】"]);
+const rhymeById = new Map(rhymes.map((r) => [r.id, r]));
+
+const isSingleHan = (s: string) => [...s].length === 1 && /^\p{Script=Han}$/u.test(s);
+
+describe("rhymes.json（韻目）", () => {
+  it("平水韻の106韻目がそろい、重複がない", () => {
+    expect(rhymes).toHaveLength(106);
+    expect(rhymeById.size).toBe(106);
+  });
+
+  it("韻目名の書き方が統一され、接頭辞と声調が合っている", () => {
+    for (const r of rhymes) {
+      const m = RHYME_ID.exec(r.id);
+      expect(m, `韻目名の書き方が違う: ${r.id}`).not.toBeNull();
+      expect(r.tone, r.id).toBe(PREFIX_TONE[m![1]!]);
+    }
+  });
+
+  it("韻目の見出し字は、その韻目の本体に載っている", () => {
+    for (const r of rhymes) {
+      const head = [...r.id].at(-1)!;
+      const reading = chars[head]?.find((x) => x.rhyme === r.id);
+      expect(reading, `${r.id} の見出し字「${head}」が載っていない`).toBeDefined();
+      expect(reading!.note, `${r.id} の見出し字「${head}」が【詞】【辭】欄にしかない`).toBeUndefined();
+    }
+  });
+});
+
+describe("chars.json（平仄データ）", () => {
+  it("同じ字が2回定義されていない（JSON として読む前のテキストで確かめる）", () => {
+    const keys = [...charsText.matchAll(/^\s*"([^"]+)":/gmu)].map((m) => m[1]!);
+    expect(keys.length).toBe(Object.keys(chars).length);
+    expect(new Set(keys).size).toBe(keys.length);
+  });
+
+  it("見出しはすべて漢字1字", () => {
+    const bad = Object.keys(chars).filter((c) => !isSingleHan(c));
+    expect(bad).toEqual([]);
+  });
+
+  it("読みの声調は 平・上・去・入 のいずれかで、韻目は rhymes.json にあり、声調と韻目が合っている", () => {
+    for (const [c, readings] of Object.entries(chars)) {
+      expect(readings.length, c).toBeGreaterThan(0);
+      for (const r of readings) {
+        expect(TONES, `${c} の声調`).toContain(r.tone);
+        const rhyme = rhymeById.get(r.rhyme);
+        expect(rhyme, `${c} の韻目 ${r.rhyme} が rhymes.json にない`).toBeDefined();
+        expect(r.tone, `${c} ${r.rhyme}`).toBe(rhyme!.tone);
+        if (r.note !== undefined) expect(NOTES, `${c} の note`).toContain(r.note);
+        expect(Object.keys(r).filter((k) => !["tone", "rhyme", "note"].includes(k)), c).toEqual([]);
+      }
+    }
+  });
+
+  it("1字の中で同じ韻目の読みが重複していない", () => {
+    for (const [c, readings] of Object.entries(chars)) {
+      const ids = readings.map((r) => r.rhyme);
+      expect(new Set(ids).size, c).toBe(ids.length);
+    }
+  });
+
+  it("どの韻目にも本体の字が1字以上ある", () => {
+    const withBody = new Set(
+      Object.values(chars).flatMap((rs) => rs.filter((r) => r.note === undefined).map((r) => r.rhyme)),
+    );
+    expect(rhymes.filter((r) => !withBody.has(r.id)).map((r) => r.id)).toEqual([]);
+  });
+});
+
+describe("corrections.json（元データの修正）", () => {
+  it("修正には理由と根拠があり、生成結果に反映されている", () => {
+    for (const c of corrections.corrections) {
+      expect(c.reason.length, `${c.char} ${c.rhyme}`).toBeGreaterThan(0);
+      expect(c.evidence.length, `${c.char} ${c.rhyme}`).toBeGreaterThan(0);
+      expect(c.action).toBe("add");
+      const reading = chars[c.char]?.find((r) => r.rhyme === c.rhyme);
+      expect(reading, `${c.char} ${c.rhyme}`).toEqual({ tone: rhymeById.get(c.rhyme)!.tone, rhyme: c.rhyme });
+    }
+  });
+});
+
+describe("variants.json（新字体・簡体字の対応）", () => {
+  it("見出しは漢字1字で、候補はすべて平仄データにあり、重複がない", () => {
+    for (const [k, cands] of Object.entries(variants)) {
+      expect(isSingleHan(k), k).toBe(true);
+      expect(cands.length, k).toBeGreaterThan(0);
+      expect(new Set(cands).size, k).toBe(cands.length);
+      for (const c of cands) expect(chars[c], `${k} → ${c}`).toBeDefined();
+    }
+  });
+
+  it("自分自身にしか対応しない見出しは載せていない", () => {
+    const selfOnly = Object.entries(variants).filter(([k, cands]) => cands.length === 1 && cands[0] === k);
+    expect(selfOnly).toEqual([]);
+  });
+});
+
+describe("kokuji.json（国字）", () => {
+  it("出典とライセンスが書かれている", () => {
+    expect(kokuji.source.url).toMatch(/^https:\/\//);
+    expect(kokuji.source.license.length).toBeGreaterThan(0);
+  });
+
+  it("漢字1字ずつで、重複がない", () => {
+    const list = kokuji.chars.map((k) => k.char);
+    expect(list.filter((c) => !isSingleHan(c))).toEqual([]);
+    expect(new Set(list).size).toBe(list.length);
+  });
+});
diff --git a/scripts/fetch_sources.py b/scripts/fetch_sources.py
new file mode 100644
index 0000000..3ace318
--- /dev/null
+++ b/scripts/fetch_sources.py
@@ -0,0 +1,140 @@
+#!/usr/bin/env python3
+"""元データを版を固定して取得し、data/raw/ に保存する（CLAUDE.md §4.3）。
+
+ネットワークを使うのはこのスクリプトだけ。生成（build_data.py）は data/raw/ だけを読む。
+取得した中身は SHA-256 で検証し、一致しなければ保存せずに失敗する。
+上流が版を消した・内容が変わった場合は、DATA_SOURCES.md を見直したうえでハッシュを更新すること。
+
+使い方:
+  python3 scripts/fetch_sources.py           # 欠けているファイルだけ取得
+  python3 scripts/fetch_sources.py --force   # すべて取得し直して検証
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import sys
+import time
+import urllib.parse
+import urllib.request
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+RAW = ROOT / "data" / "raw"
+USER_AGENT = "kanshi-app/0.1 (https://github.com/adatic/kanshi-app; data fetch)"
+
+OPENCC_TAG = "ver.1.4.2"
+OPENCC_BASE = f"https://raw.githubusercontent.com/BYVoid/OpenCC/{OPENCC_TAG}"
+
+
+def mediawiki_revision(api: str, revid: int) -> str:
+    query = urllib.parse.urlencode(
+        {
+            "action": "query",
+            "prop": "revisions",
+            "revids": str(revid),
+            "rvprop": "ids|content",
+            "rvslots": "main",
+            "format": "json",
+            "formatversion": "2",
+        }
+    )
+    return f"{api}?{query}"
+
+
+# path: data/raw/ からの相対パス
+# kind: "mediawiki" は API の JSON から本文（wikitext）を取り出して保存する
+SOURCES = [
+    {
+        "path": "wikisource-pingshui-8264804.wiki",
+        "kind": "mediawiki",
+        "url": mediawiki_revision("https://zh.wikisource.org/w/api.php", 8264804),
+        "sha256": "c0003fa238f6cb2c767f7747fae33eecde8c06da3eb661ab9d48bbff655857d9",
+    },
+    {
+        "path": "wikipedia-ja-wasei-kanji-109822326.wiki",
+        "kind": "mediawiki",
+        "url": mediawiki_revision("https://ja.wikipedia.org/w/api.php", 109822326),
+        "sha256": "c8701426f6a5bd74b96337ef037851a6d613a16a5c47812cd1b77fc8950cfe1c",
+    },
+    {
+        "path": f"opencc-{OPENCC_TAG}/STCharacters.txt",
+        "kind": "file",
+        "url": f"{OPENCC_BASE}/data/dictionary/STCharacters.txt",
+        "sha256": "a0ca1601c70648cf48b33c3c6210ccbecc5c7eead4b4c3daf76587ba2c03582b",
+    },
+    {
+        "path": f"opencc-{OPENCC_TAG}/JPShinjitaiCharacters.txt",
+        "kind": "file",
+        "url": f"{OPENCC_BASE}/data/dictionary/JPShinjitaiCharacters.txt",
+        "sha256": "12cec7250b873ef52b36d8f92218d4f92c0aaf5d8cd7c58fe42d9785bdcdc43a",
+    },
+    {
+        "path": f"opencc-{OPENCC_TAG}/LICENSE",
+        "kind": "file",
+        "url": f"{OPENCC_BASE}/LICENSE",
+        "sha256": "b534e465949558eec2597b04f5092b5e161236a68dfbfd04d547592ac3964308",
+    },
+]
+
+
+def http_get(url: str) -> bytes:
+    """GET する。429（混雑）なら Retry-After だけ待って最大5回まで取り直す。"""
+    for attempt in range(5):
+        req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
+        try:
+            with urllib.request.urlopen(req, timeout=60) as res:
+                return res.read()
+        except urllib.error.HTTPError as e:
+            if e.code != 429 or attempt == 4:
+                raise
+            wait = int(e.headers.get("Retry-After", "10"))
+            print(f"  429 Too Many Requests: {wait}秒待って再試行します", file=sys.stderr)
+            time.sleep(wait)
+    raise AssertionError("unreachable")
+
+
+def extract_mediawiki_content(body: bytes) -> bytes:
+    data = json.loads(body)
+    page = data["query"]["pages"][0]
+    content = page["revisions"][0]["slots"]["main"]["content"]
+    return content.encode("utf-8")
+
+
+def fetch(source: dict, force: bool) -> bool:
+    dest = RAW / source["path"]
+    if dest.exists() and not force:
+        ok = hashlib.sha256(dest.read_bytes()).hexdigest() == source["sha256"]
+        print(f"{'ok  ' if ok else 'NG  '} {source['path']}（既存ファイルを検証）")
+        return ok
+    print(f"取得 {source['path']}")
+    body = http_get(source["url"])
+    if source["kind"] == "mediawiki":
+        body = extract_mediawiki_content(body)
+    digest = hashlib.sha256(body).hexdigest()
+    if digest != source["sha256"]:
+        print(
+            f"NG   {source['path']}: SHA-256 が一致しません\n"
+            f"     期待値 {source['sha256']}\n"
+            f"     実際   {digest}",
+            file=sys.stderr,
+        )
+        return False
+    dest.parent.mkdir(parents=True, exist_ok=True)
+    dest.write_bytes(body)
+    print(f"ok   {source['path']}")
+    return True
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument("--force", action="store_true", help="既存ファイルがあっても取得し直す")
+    args = parser.parse_args()
+    results = [fetch(s, args.force) for s in SOURCES]
+    return 0 if all(results) else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/scripts/test_build_data.py b/scripts/test_build_data.py
new file mode 100644
index 0000000..1366a0c
--- /dev/null
+++ b/scripts/test_build_data.py
@@ -0,0 +1,141 @@
+"""scripts/build_data.py の単体テスト。`npm test`（npm run data:unit）で走る。
+
+入力は架空の小さな表で、生成ロジックの境界だけを確かめる。
+平仄・韻目の正誤は扱わない（読みは形を満たすだけの仮の値）。
+"""
+
+import unittest
+
+from build_data import BuildError, apply_corrections, build_chars, build_variants, parse_wikisource
+
+R = {"tone": "平", "rhyme": "上平一東"}  # 仮の読み
+
+
+class BuildVariantsTest(unittest.TestCase):
+    def run_variants(self, chars, jp=None, st=None):
+        return build_variants({c: [R] for c in chars}, jp or {}, st or {})
+
+    def test_one_to_many_with_one_known_candidate_is_reported(self):
+        # 甲 → 乙 丙 のうち、データにあるのは丙だけ
+        variants, ambiguous, unmapped = self.run_variants(["丙"], jp={"甲": ["乙", "丙"]})
+        self.assertEqual(variants, {"甲": ["丙"]})
+        self.assertEqual(len(ambiguous), 1)
+        self.assertTrue(ambiguous[0].startswith("甲\t1/2\t"))
+        self.assertIn("乙（新字体→旧字体: 平仄データにない）", ambiguous[0])
+        self.assertEqual(unmapped, [])
+
+    def test_one_to_many_with_all_known_keeps_every_candidate(self):
+        variants, ambiguous, _ = self.run_variants(["乙", "丙"], st={"甲": ["乙", "丙"]})
+        self.assertEqual(variants, {"甲": ["乙", "丙"]})
+        self.assertTrue(ambiguous[0].startswith("甲\t2/2\t"))
+
+    def test_key_itself_counts_as_a_candidate_when_known(self):
+        # 甲 自身がデータにあり、さらに 乙 にも対応する
+        variants, ambiguous, _ = self.run_variants(["甲", "乙"], jp={"甲": ["乙"]})
+        self.assertEqual(variants, {"甲": ["甲", "乙"]})
+        self.assertIn("甲（自身: 上平一東）", ambiguous[0])
+
+    def test_known_self_with_unknown_other_is_reported_but_not_listed(self):
+        variants, ambiguous, unmapped = self.run_variants(["甲"], jp={"甲": ["乙"]})
+        self.assertEqual(variants, {})
+        self.assertTrue(ambiguous[0].startswith("甲\t1/2\t"))
+        self.assertEqual(unmapped, [])
+
+    def test_one_to_one_is_not_ambiguous(self):
+        variants, ambiguous, unmapped = self.run_variants(["乙"], jp={"甲": ["乙"]})
+        self.assertEqual(variants, {"甲": ["乙"]})
+        self.assertEqual(ambiguous, [])
+        self.assertEqual(unmapped, [])
+
+    def test_no_known_candidate_goes_to_unmapped(self):
+        variants, _, unmapped = self.run_variants([], st={"甲": ["乙"]})
+        self.assertEqual(variants, {})
+        self.assertEqual(unmapped, ["甲\t簡体字→繁体字\t候補: 乙"])
+
+    def test_unmapped_lists_shinjitai_before_simplified(self):
+        _, _, unmapped = self.run_variants([], jp={"丁": ["乙"]}, st={"丙": ["丑"]})
+        # 丙（U+4E19）は丁（U+4E01）より後ろの字だが、新字体由来の丁を先に並べる
+        self.assertEqual([row[0] for row in unmapped], ["丁", "丙"])
+
+    def test_multi_char_keys_are_ignored(self):
+        variants, ambiguous, unmapped = self.run_variants(["乙"], st={"甲乙": ["乙"]})
+        self.assertEqual((variants, ambiguous, unmapped), ({}, [], []))
+
+
+WIKI = """\
+==上平聲部==
+上平聲一{{++|東}}
+
+東同
+
+【詞】中同
+
+上平聲二{{++|冬}}
+
+冬
+==上聲部==
+上聲一{{++|董}}
+
+董同
+"""
+
+
+class ParseAndBuildCharsTest(unittest.TestCase):
+    def test_supplement_marker_is_kept_and_body_wins_on_duplicate(self):
+        rhymes, entries = parse_wikisource(WIKI)
+        self.assertEqual([r["id"] for r in rhymes], ["上平一東", "上平二冬", "上声一董"])
+        chars, dups = build_chars(rhymes, entries)
+        self.assertEqual(chars["中"], [{"tone": "平", "rhyme": "上平一東", "note": "【詞】"}])
+        # 同は本体と【詞】の両方に載る → 本体を採り、重複として記録する
+        self.assertEqual(
+            chars["同"],
+            [{"tone": "平", "rhyme": "上平一東"}, {"tone": "上", "rhyme": "上声一董"}],
+        )
+        self.assertEqual(len(dups), 1)
+        self.assertTrue(dups[0].startswith("同\t上平一東\t本体と【詞】"))
+
+    def test_non_han_text_stops_the_build(self):
+        with self.assertRaises(BuildError):
+            parse_wikisource("上平聲一{{++|東}}\n東Public\n")
+
+    def test_body_before_first_heading_stops_the_build(self):
+        with self.assertRaises(BuildError):
+            parse_wikisource("東同\n")
+
+
+class ApplyCorrectionsTest(unittest.TestCase):
+    def setUp(self):
+        self.rhymes, entries = parse_wikisource(WIKI)
+        self.chars, _ = build_chars(self.rhymes, entries)
+
+    def correction(self, **kw):
+        base = {"action": "add", "char": "冬", "rhyme": "上平一東", "reason": "r", "evidence": ["e"]}
+        return {**base, **kw}
+
+    def test_add_inserts_reading_in_rhyme_order(self):
+        chars, applied = apply_corrections(self.chars, self.rhymes, [self.correction()])
+        self.assertEqual(
+            chars["冬"],
+            [{"tone": "平", "rhyme": "上平一東"}, {"tone": "平", "rhyme": "上平二冬"}],
+        )
+        self.assertEqual(len(applied), 1)
+
+    def test_add_promotes_supplement_reading_to_body(self):
+        chars, _ = apply_corrections(self.chars, self.rhymes, [self.correction(char="中")])
+        self.assertEqual(chars["中"], [{"tone": "平", "rhyme": "上平一東"}])
+
+    def test_unneeded_correction_stops_the_build(self):
+        with self.assertRaises(BuildError):
+            apply_corrections(self.chars, self.rhymes, [self.correction(char="東")])
+
+    def test_correction_without_evidence_stops_the_build(self):
+        with self.assertRaises(BuildError):
+            apply_corrections(self.chars, self.rhymes, [self.correction(evidence=[])])
+
+    def test_unknown_rhyme_stops_the_build(self):
+        with self.assertRaises(BuildError):
+            apply_corrections(self.chars, self.rhymes, [self.correction(rhyme="上平九十九無")])
+
+
+if __name__ == "__main__":
+    unittest.main()
