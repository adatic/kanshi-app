{
  "name": "kanshi-app",
  "private": true,
  "description": "七言絶句の作詩を支援する静的Webアプリ",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/engine/tsconfig.json",
    "test": "npm run typecheck && npm run data:unit && npm run data:verify && vitest run",
    "data:fetch": "python3 scripts/fetch_sources.py",
    "data:build": "python3 scripts/build_data.py",
    "data:verify": "python3 scripts/build_data.py --check && python3 scripts/build_golden_input.py --check && python3 scripts/build_phrases.py --check",
    "data:unit": "python3 -m unittest discover -s scripts -p \"test_*.py\"",
    "golden:find": "python3 scripts/find_golden_sources.py",
    "golden:fetch": "python3 scripts/fetch_golden_sources.py",
    "golden:input": "python3 scripts/build_golden_input.py",
    "golden:update": "GOLDEN_UPDATE=1 vitest run golden",
    "corpus:fetch": "python3 scripts/fetch_corpus.py",
    "phrases:build": "python3 scripts/build_phrases.py"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
