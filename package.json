{
  "name": "kanshi-app",
  "private": true,
  "description": "七言絶句の作詩を支援する静的Webアプリ",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/engine/tsconfig.json",
    "test": "npm run typecheck && npm run data:verify && vitest run",
    "data:fetch": "python3 scripts/fetch_sources.py",
    "data:build": "python3 scripts/build_data.py",
    "data:verify": "python3 scripts/build_data.py --check"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
