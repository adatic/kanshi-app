{"2":[{"w":"讓德","n":4,"at":{"1-2":1,"3-4":1,"6-7":2},"p":["仄仄"],"r":["去声四寘","入声十三職"],"e":[["杜牧","長安雜題長句六首 六","誰識大君謙讓德"],["蕭遘","和王侍中謁張惡子廟","青骨祀吳誰讓德"],["拓善","和韋莊賀陳詠歸蜀（句）（唐前朝進士陳詠，眉州青神人，有詩名，善弈棊。昭宗劫遷，駐蹕陝郊，是歲策名歸蜀，韋書記莊以詩賀之。又有鄉人拓善者，屬和韋詩，其略云云，譏其比滌器當壚也。謬稱馮副使涓詩，以涓多諧戲故也。或云：蜀之拓善者作此詩，假馮公之名也。）","讓德已聞多士伏"]]},{"w":"讓却","n":2,"at":{"1-2":1,"3-4":1},"p":["仄仄"],"r":["入声十藥","入声十一陌"],"e":[["趙嘏","送陳嘏登第作尉歸覲","清資讓却校書郎"],["崔道融","寓吟集","讓却詩人作酒魁"]]},{"w":"讓太","n":2,"at":{"5-6":2},"p":["仄仄"],"r":["去声九泰"],"e":[["錢起","和王員外雪晴早朝","已覺輕寒讓太陽"]]},{"w":"讓後","n":2,"at":{"5-6":2},"p":["仄仄"],"r":["上声二十五有","去声二十六宥"],"e":[["劉禹錫","樂天見示傷微之敦詩晦叔三君子皆有深分因成是詩以寄","流水前波讓後波"],["徐鉉","奉和宮傅相公懷舊見寄四十韻","流輩班資讓後先"]]},{"w":"讓清","n":2,"at":{"5-6":2},"p":["仄平"],"r":["下平八庚"],"e":[["劉禹錫","贈劉景擢第","五陵年少讓清光"],["羅鄴","白角簟","露華煙魄讓清光"]]},{"w":"讓王","n":2,"at":{"1-2":1,"6-7":1},"p":["仄仄","仄平"],"r":["下平七陽","去声二十三漾"],"e":[["陸龜蒙","送羊振文先輩往桂陽歸覲","讓王門外開帆葉"],["陸龜蒙","和襲美泰伯廟","不信人間有讓王"]]},{"w":"讓花","n":2,"at":{"5-6":1,"6-7":1},"p":["仄平"],"r":["下平六麻"],"e":[["駱賓王","疇昔篇","屋裏新妝不讓花"],["白居易","宴周皓大夫光福宅","紅櫻無色讓花鈿"]]}],"3":[{"w":"讓太陽","n":2,"at":{"5-7":2},"p":["仄仄平"],"r":["下平七陽"],"e":[["錢起","和王員外雪晴早朝","已覺輕寒讓太陽"]]},{"w":"讓清光","n":2,"at":{"5-7":2},"p":["仄平平"],"r":["下平七陽"],"e":[["劉禹錫","贈劉景擢第","五陵年少讓清光"],["羅鄴","白角簟","露華煙魄讓清光"]]}]}
